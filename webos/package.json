{
  "name": "iptv-player-webos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "package": "npm run build && cp appinfo.json icon.png icon_large.png dist/ && ares-package dist -o build --no-minify",
    "install:tv": "ares-install --device tv build/com.iptv.player.webos_0.1.0_all.ipk",
    "launch:tv": "ares-launch --device tv com.iptv.player.webos",
    "inspect:tv": "ares-inspect --device tv --app com.iptv.player.webos --open"
  },
  "dependencies": {
    "@noriginmedia/norigin-spatial-navigation": "^2.2.0",
    "fast-xml-parser": "^4.5.0",
    "hls.js": "^1.5.17",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
