# ==============================================
# BTC Bot — Variables de Entorno
# ==============================================
# Copiá este archivo como .env y completá los valores:
#   cp .env.example .env
#   nano .env
# ==============================================

# --- Dónde se muestran los mensajes del bot ---
# telegram = mensajes y comandos por Telegram
# consola  = mensajes en la ventana de la consola y comandos escritos por teclado
#            (no hace falta configurar Telegram)
NOTIFICACIONES=telegram

# --- Telegram (obligatorio solo si NOTIFICACIONES=telegram) ---
# Creá un bot con @BotFather en Telegram y pegá el token acá
TELEGRAM_BOT_TOKEN=tu_token_aqui
# Tu chat ID personal (podés obtenerlo con @userinfobot)
TELEGRAM_CHAT_ID=tu_chat_id_aqui

# --- Binance (opcional para Fase 1-2, obligatorio para Fase 4-5) ---
# Creá API keys en https://www.binance.com/en/my/settings/api-management
# Para Fase 4-5 necesitás permisos de Spot Trading
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = usar la testnet de Binance (dinero ficticio). Las keys de testnet se crean
# en https://testnet.binance.vision (son distintas a las de la cuenta real)
BINANCE_TESTNET=false
# Comisión de Binance por operación en porcentaje (0.1 = tarifa estándar de Spot)
COMISION_PORCENTAJE=0.1

# --- Gemini / Google AI Studio (obligatorio para Fase 3+) ---
# Obtené tu API key gratis en https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Modelo de Gemini a usar
GEMINI_MODEL=gemini-2.5-flash

# --- Base de datos ---
DB_PATH=btc_bot.db

# --- Monitoreo ---
# Intervalo entre consultas de precio (en segundos, default 300 = 5 min)
MONITOR_INTERVAL=300
# Horarios de resumen diario (formato HH:MM, separados por coma)
RESUMEN_HORARIOS=09:00,21:00
# Umbral de variación 24h para activar alerta (en porcentaje)
ALERTA_VARIACION_24H=5.0

# --- Zona horaria ---
# Zona horaria para los horarios de resumen
TIMEZONE=America/Argentina/Buenos_Aires

# --- Fases del bot (true/false) ---
# Fase 3: Análisis con Gemini cuando hay alerta de variación
FASE_3_GEMINI=false
# Fase 4: Botones de compra manual en Telegram
FASE_4_MANUAL=false
# Fase 5: Auto-trading con límites de seguridad
FASE_5_AUTO=false

# --- Límites de Trading (Fase 4 y 5) ---
# Monto máximo por operación en USDT
TRADE_MAX_POR_OPERACION=50.0
# Monto máximo acumulado por semana en USDT
TRADE_MAX_POR_SEMANA=200.0
# Porcentaje de caída del portfolio para activar stop-loss y pausar todo
# (también se aplica al presupuesto del modo autónomo)
STOP_LOSS_PORCENTAJE=20.0

# --- Trading autónomo (compra y vende solo) ---
# Requiere BINANCE_API_KEY/SECRET con permiso de Spot Trading y GEMINI_API_KEY.
# La IA decide cuándo comprar (solo si ve un margen que valga la pena);
# la venta la hacen reglas fijas (objetivo o stop-loss).
# No conviene activarlo junto con FASE_5_AUTO: ambos usarían el mismo USDT.
AUTONOMO=false
# Plata que el bot puede usar. Opera solo con esto y reinvierte el resultado.
AUTONOMO_PRESUPUESTO_USDT=20.0
# Ganancia neta mínima (después de comisiones) que la IA tiene que esperar para comprar
AUTONOMO_MARGEN_MINIMO=1.0
# Tope del objetivo de venta que puede proponer la IA (en %)
AUTONOMO_TAKE_PROFIT_MAX=5.0
# Vende si la posición pierde este porcentaje
AUTONOMO_STOP_LOSS=3.0
# Cada cuántos minutos se consulta a la IA cuando no hay posición abierta
AUTONOMO_INTERVALO_ANALISIS=60

# --- Par de trading ---
TRADING_PAIR=BTCUSDT
