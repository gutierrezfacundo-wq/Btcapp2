<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ni el backup en la nube ni el pase a un teléfono nuevo se
     llevan la base (servidor, usuario y contraseña de las listas) ni las
     preferencias (credenciales viejas y PIN parental). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="iptv.db" />
        <exclude domain="database" path="iptv.db-wal" />
        <exclude domain="database" path="iptv.db-shm" />
        <exclude domain="database" path="iptv.db-journal" />
        <exclude domain="file" path="datastore/iptv_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="iptv.db" />
        <exclude domain="database" path="iptv.db-wal" />
        <exclude domain="database" path="iptv.db-shm" />
        <exclude domain="database" path="iptv.db-journal" />
        <exclude domain="file" path="datastore/iptv_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
